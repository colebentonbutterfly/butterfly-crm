# REQUIRED: Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# REQUIRED: Set to your server's public URL (use HTTPS in production)
NEXTAUTH_URL=http://localhost:3000

# REQUIRED: Database file path (SQLite)
# Default: file:./prisma/dev.db (relative to project root)
# For Docker: file:/app/prisma/dev.db
DATABASE_URL=file:./prisma/dev.db

# Optional: eBay price lookup API credentials
# Sign up at https://developer.ebay.com/ for Production keys
EBAY_APP_ID=
EBAY_CERT_ID=
