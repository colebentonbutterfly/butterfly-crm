# Written by "2 build studio.sh" as /opt/design-studio/.env (mode 600).
# The real file holds secrets: keep the desktop password in Infisical (CT 131).

# The studio's tailnet name. NEVER change this once floor plans exist:
# every plan stores furniture and texture links that start with it.
STUDIO_HOST=design-studio.tailadab47.ts.net

# HTTPS ports published by tailscale serve. If a Tailscale version refuses
# 8444/8445, use 10000/10001 here and rerun "2 build studio.sh".
STUDIO_PORT=443
FREECAD_PORT=8443
BLENDER_PORT=8444
QGIS_PORT=8445

# Login for the FreeCAD, Blender and QGIS desktops.
DESKTOP_USER=cole
DESKTOP_PASSWORD=change-me

# Shared secret between Nextcloud and the whiteboard backend (phase 6).
WHITEBOARD_JWT_SECRET=change-me
NEXTCLOUD_URL=https://cloud.butterflyassets.com

# The Butterfly Drive tile on the home page.
DRIVE_URL=https://cloud.butterflyassets.com/apps/files/?dir=/Design%20Studio

TZ=America/New_York

# true when the CT has no IPv6 (detected by the build script).
DISABLE_IPV6=
