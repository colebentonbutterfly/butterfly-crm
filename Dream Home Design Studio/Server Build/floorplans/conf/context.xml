<?xml version="1.0" encoding="UTF-8"?>
<!-- Textures and models Cole imports are uploaded by writeResource.jsp to
     STUDIO_RESOURCES_DIR and read back from /userResources/. -->
<Context>
  <Resources cachingAllowed="false">
    <PreResources className="org.apache.catalina.webresources.DirResourceSet"
                  base="/data/.studio/user-resources"
                  webAppMount="/userResources" />
  </Resources>
  <!-- No session persistence across restarts -->
  <Manager pathname="" />
</Context>
