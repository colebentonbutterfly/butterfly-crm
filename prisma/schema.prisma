datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
}

model Box {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String?  // optional custom name like "Kitchen Stuff"
  barcode   String   @unique
  location  String   @default("Pod 1")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]

  @@index([location])
  @@index([createdAt])
}

model Item {
  id             String         @id @default(cuid())
  name           String
  description    String?
  category       String
  location       String         // "Pod 1", "Pod 2", "Shipping Container", "Donated", "Trash"
  condition      String?        // "Good", "Fair", "Poor", "New"
  quantity       Int            @default(1)
  barcode        String         @unique
  photoUrl       String?
  photoUrls      String?        // JSON array of additional photo URLs
  notes          String?
  boxNumber      String?        // legacy text field for backward compat
  boxId          String?        // relation to Box model
  box            Box?           @relation(fields: [boxId], references: [id])
  estimatedValue Float?         // estimated dollar value
  tags           String?        // JSON array of tag strings
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  activityLogs   ActivityLog[]

  @@index([category])
  @@index([location])
  @@index([boxId])
  @@index([createdAt])
  @@index([updatedAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  action    String   // "created", "updated", "moved", "deleted"
  details   String   // human-readable description
  user      String   // username who performed action
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6b7280") // hex color
}
